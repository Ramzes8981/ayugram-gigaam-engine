NATIVE_LIB_BASE64 = ''


def _monotonic():
    return time.monotonic()


def _process_cpu():
    return time.process_time()


def _short_exc(e):
    # Avoid including arbitrary paths / audio data from exception messages.
    return type(e).__name__


def _kb_from_proc_status():
    result = {}
    with open('/proc/self/status', 'r') as f:
        for row in f:
            if row.startswith(('VmRSS:', 'VmHWM:', 'VmSize:', 'VmSwap:', 'Threads:')):
                key, value = row.split(':', 1)
                tokens = value.split()
                if tokens:
                    try:
                        result[key] = int(tokens[0])
                    except ValueError:
                        pass
    return result


def _pss_kb():
    # Usually readable for own PID, but denied on some vendor kernels.
    try:
        with open('/proc/self/smaps_rollup', 'r') as f:
            for row in f:
                if row.startswith('Pss:'):
                    return int(row.split()[1])
    except (OSError, ValueError):
        pass
    return None


def _available_ram_kb():
    try:
        with open('/proc/meminfo', 'r') as f:
            for row in f:
                if row.startswith('MemAvailable:'):
                    return int(row.split()[1])
    except (OSError, ValueError):
        pass
    return None


def _android_power():
    """Best-effort telemetry; never fails a transcription if device hides it."""
    out = {}
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        if ctx is None:
            return out
        try:
            battery = ctx.getSystemService('batterymanager')
            if battery is not None:
                from android.os import BatteryManager
                val = int(battery.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY))
                if 0 <= val <= 100:
                    out['battery_pct'] = val
        except Exception:
            pass
        try:
            pm = ctx.getSystemService('power')
            if pm is not None:
                # API 29+. Value is thermal *status*, not temperature in Celsius.
                out['thermal_status'] = int(pm.getCurrentThermalStatus())
        except Exception:
            pass
    except Exception:
        pass
    return out


def _memory_sample(include_pss=False, include_system=False, include_power=False):
    row = {'mono': _monotonic(), 'cpu': _process_cpu()}
    try:
        d = _kb_from_proc_status()
        row['rss_mb'] = round(d.get('VmRSS', 0) / 1024.0, 1) if 'VmRSS' in d else None
        row['hwm_mb'] = round(d.get('VmHWM', 0) / 1024.0, 1) if 'VmHWM' in d else None
        row['vms_mb'] = round(d.get('VmSize', 0) / 1024.0, 1) if 'VmSize' in d else None
        row['swap_mb'] = round(d.get('VmSwap', 0) / 1024.0, 1) if 'VmSwap' in d else None
        row['threads'] = d.get('Threads')
    except Exception:
        row.update(rss_mb=None, hwm_mb=None, vms_mb=None, swap_mb=None, threads=None)
    if include_pss:
        pss = _pss_kb()
        row['pss_mb'] = round(pss / 1024.0, 1) if pss is not None else None
    if include_system:
        available = _available_ram_kb()
        row['sys_available_mb'] = round(available / 1024.0, 1) if available is not None else None
    if include_power:
        row.update(_android_power())
    return row


def _fmt(data):
    return ' '.join('%s=%s' % (k, v) for k, v in data.items() if v is not None)


def _audio_duration_ms(path):
    # Android built-in MediaMetadataRetriever supports the original OGG/OPUS.
    # It may still fail depending on vendor firmware / file state.
    retriever = None
    try:
        from android.media import MediaMetadataRetriever
        retriever = MediaMetadataRetriever()
        retriever.setDataSource(path)
        value = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)
        return int(str(value)) if value else None
    except Exception:
        return None
    finally:
        if retriever is not None:
            try:
                retriever.release()
            except Exception:
                pass


